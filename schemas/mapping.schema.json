{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mapping.schema.json",
  "type": "object",
  "required": ["tasklists"],
  "properties": {
    "project": {"type": "string"},
    "tasklists": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["guid", "parent_tasks"],
        "properties": {
          "name": {"type": "string"},
          "guid": {"type": "string", "minLength": 1},
          "parent_tasks": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["guid", "subtasks"],
              "properties": {
                "guid": {"type": "string", "minLength": 1},
                "subtasks": {
                  "type": "object",
                  "additionalProperties": {"type": "string", "minLength": 1}
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
